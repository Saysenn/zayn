# PORT=3000
PORT=3000

# Supabase Postgres connection string (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Signs the session cookie issued after a successful login
JWT_SECRET=change-me-too

# Signs cookies at the cookie-parser layer (separate from JWT_SECRET)
COOKIE_SECRET=change-me-as-well

# Shared secret whatbot sends as the x-api-key header on every call to
# /api/v1/agent/* — service-to-service auth, unrelated to admin login
AGENT_API_KEY=change-me-as-well-2

# Vite dev server origin, for CORS in development
CORS_ORIGIN=http://localhost:5173

# whatbot's admin-reply webhook — the CRM calling INTO whatbot to send a
# WhatsApp message from the chatbox. whatbot's worker.js (WORKER_PORT)
# defaults to 3002 — NOT whatbot's own PORT (server.js, usually 3001).
# WHATBOT_WEBHOOK_KEY must match whatbot's own ADMIN_REPLY_WEBHOOK_KEY.
# Chat sending fails clearly (not silently) until both are set.
WHATBOT_WEBHOOK_URL=http://localhost:3002
WHATBOT_WEBHOOK_KEY=change-me-as-well-3

# ────────────────────────────────────────────────────────────────────
# DIANE
#
# Two lines is the whole setup on OpenAI. Everything below them is an
# override with a working default:
#
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#
# One key then serves all three things she does — chat, hearing and
# speaking — because OpenAI is the only provider that has all three
# endpoints. Options: openai, groq, cerebras, gemini, openrouter.
#
#   chat        every provider
#   transcribe  openai, groq
#   speech      openai only
#
# Pick a provider without /audio/speech and she still works, she just
# falls back to the browser's own robot voice. Pick one without
# /audio/transcriptions and the mic button hides. Neither is an error.
# ────────────────────────────────────────────────────────────────────
# AI_PROVIDER=openai
# AI_API_KEY=REPLACE_WITH_YOUR_API_KEY
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=

# HEARING. Only needed when the chat provider cannot transcribe, or to
# point it somewhere else. Defaults to the chat provider and key.
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_API_KEY=REPLACE_WITH_YOUR_API_KEY
# TRANSCRIBE_MODEL=whisper-1

# SPEAKING. Defaults to the chat provider and key when that provider can
# speak, which since AI_PROVIDER=openai it can. Only set SPEECH_API_KEY if
# the chat model lives somewhere without /audio/speech (Groq, Cerebras).
#
# gpt-4o-mini-tts is the only model that reads OPENAI_TTS_INSTRUCTIONS,
# and that string is what stops her sounding like an announcer. tts-1 is
# marginally faster and ignores it.
# SPEECH_API_KEY=REPLACE_WITH_YOUR_REAL_OPENAI_API_KEY
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=shimmer
# OPENAI_TTS_INSTRUCTIONS=

# The pre-AI_PROVIDER names. Still read so an old .env keeps working;
# AI_* wins when both are set.
# OPENAI_API_KEY=
# OPENAI_TTS_API_KEY=

# First-time setup, once DATABASE_URL is set:
#   npm run migrate
#   npm run seed-admin -- <username> <password>

# LIVE FX RATES, for the export's "Converted to USD" breakdown.
# Free, no key, no signup. USD base, ~160 currencies including AED and GBP.
# Daily, mid-market. Unset means the built-in fallback rate is used.
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# How much conversation Diane keeps in mind, in characters. Default 200000
# (~50k tokens, several hundred turns). The whole history is resent every
# turn, so raising it raises the per-turn cost of a long session.
# AGENT_HISTORY_CHARS=200000

# WHERE THE BUSINESS IS, as an IANA zone name. This decides which calendar
# month a total, a cell colour and an export are for. Unset, the host's own
# zone is used, which is UTC on most cloud servers: seven hours ahead of
# Pacific, so the last evening of every month reads as the next one.
TIMEZONE=America/Los_Angeles

# ---- Expense receipts (kept with their expense, 3 months) ----
# Where receipts are kept. Default: crm/api/storage/receipts
RECEIPTS_DIR=
# A copy of the receipts folder goes here every 6 hours, when set.
RECEIPTS_BACKUP_DIR=
