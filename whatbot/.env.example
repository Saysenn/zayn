NODE_ENV=development
PORT=3000
# LOG_LEVEL=info

# --- Redis (Upstash: the TCP string, not the REST one) ---
REDIS_URL=rediss://default:REPLACE_WITH_YOUR_REDIS_PASSWORD@your-instance.upstash.io:6379

# --- WhatsApp (Baileys — ordinary accounts, no Meta, no Twilio) ---
# One entry per group: "GROUPID:+E164". The group ID must match the sheet's
# Group column exactly. A group with no number here is never messaged.
WHATSAPP_NUMBERS=MILKMAN:+440000000001,INDIGO:+440000000002
# This folder IS the login for every number. Never commit it, never log it.
WHATSAPP_AUTH_DIR=auth_info
# qr = scan a QR printed in the terminal; code = type an 8 character code on
# the phone (Linked devices → Link a device → Link with phone number instead)
WHATSAPP_LINK_WITH=qr
# The expense bot's previews as a picture with a caption (false = text)
FEATURE_EXPENSE_IMAGES=true
# The pay breakdown as a picture (false = text)
FEATURE_PAY_IMAGES=true
# Picture look if the CRM cannot be asked: sheet, notebook, receipt, ledger, chalkboard
PICTURE_STYLE=sheet
# The pay breakdown's own look, never the CRM's expense style (default: notebook)
PAY_PICTURE_STYLE=notebook

# --- LLM: any OpenAI-compatible endpoint ---
OPENAI_API_KEY=REPLACE_WITH_YOUR_API_KEY
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Gemini instead:
# OPENAI_MODEL=gemini-flash-latest
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# live = real model. mock = deterministic keyword routing, zero API calls.
# Switch to mock when a free-tier daily quota runs out — everything except
# model tool-selection still runs for real. Never mock in production.
LLM_MODE=live

# --- Data: fake | excel | sheets ---
DATA_SOURCE=fake
# EXCEL_PATH=/path/to/master.xlsx
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# GOOGLE_SHEET_ID=REPLACE_WITH_YOUR_SHEET_ID
# SHEET_SKIP_TABS=Summary,Notes

# --- Toggles: whole features, on or off. See docs/features.md ---
# Sending files (the CSV breakdown). Off means the tool is never loaded and the
# model is told we cannot send files, so it never promises one.
FEATURE_DOCUMENTS=false

# Listening to voice notes. Inbound only — replies are always text, never audio.
# Needs a provider that serves Whisper on OPENAI_BASE_URL (Groq or OpenAI;
# Gemini's compatibility layer does not).
FEATURE_VOICE=false
TRANSCRIBE_MODEL=whisper-large-v3
# longest note we will transcribe. transcription is billed by audio length.
VOICE_MAX_SECONDS=120

# --- Behaviour ---
REVIEW_THRESHOLD=5
BREAKDOWN_DETAIL_LIMIT=25
SYNC_INTERVAL_MINUTES=15
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=200

# --- Audit: redis | postgres ---
AUDIT_STORE=redis
# DATABASE_URL=postgres://user:password@localhost:5432/whatbot

# --- CRM (crm/api) — service-to-service, must match crm/api/.env's AGENT_API_KEY ---
# CRM_API_URL=http://localhost:3000
# CRM_AGENT_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_NOT_A_REAL_PROVIDER_KEY

# The other direction: crm/api calling INTO worker.js to deliver a chatbox
# reply over WhatsApp. Must match crm/api/.env's WHATBOT_WEBHOOK_KEY. Distinct
# from PORT (server.js) on purpose — both processes run at once.
# ADMIN_REPLY_WEBHOOK_KEY=REPLACE_WITH_A_RANDOM_SECRET
# WORKER_PORT=3002

# --- Payday check ---
# true = print what would be sent. false sends to real people — an untargeted
# --send hits everyone on the sheet, so leave this true unless you mean it.
PAYDAY_DRY_RUN=true
PAYDAY_SCHEDULE=off
PAYDAY_SEND_GAP_MINUTES=15
PAYDAY_RESPONSE_DAYS=3
