{
  "name": "whatbot",
  "version": "1.0.0",
  "description": "WhatsApp assistant for payroll questions",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "test": "vitest",
    "chat": "node src/chat.js",
    "smoke": "node src/smoke.js",
    "sync": "node -e \"import('./src/sheet/syncSheet.js').then(m=>m.syncSheet()).then(r=>{console.log(r);process.exit(0)})\"",
    "sync:crm": "node -e \"import('./src/sheet/syncToCrm.js').then(m=>m.syncToCrm()).then(r=>{console.log(r);process.exit(0)})\"",
    "pull:master-sheet": "node -e \"import('./src/sheet/pullMasterSheet.js').then(m=>m.pullMasterSheet()).then(r=>{console.log(r);process.exit(0)})\"",
    "eval": "node src/agent/evals/runEvals.js",
    "payday": "node src/payday.js",
    "chat:expenses": "node src/expenseChat.js"
  },
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bullmq": "^5.81.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.10"
  }
}
